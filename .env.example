# PrigenFi configuration template. Copy only what you need; never commit real values.
# NO signing secrets (private keys, seed phrases, mnemonics) belong anywhere in
# PrigenFi configuration. All signing is wallet-mediated in the browser.
# Check readiness without printing values:  pnpm env:check --file apps/web/.env.local
# Full guide: docs/LOCAL_OPERATOR_RUNBOOK.md

# ---------------------------------------------------------------------------
# 1. CLI services (shell exports; there is no automatic root dotenv loading)
# ---------------------------------------------------------------------------
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
API_PORT=3001
# Optional developer MCP fixed scope (pnpm mcp:dev only; local Anvil addresses):
# VAULT_ADDRESS=
# AGENT_ADDRESS=
# TOKEN_ADDRESS=
# Local Anvil RPC used by deploy/integration scripts (loopback only):
# LOCAL_RPC_URL=http://127.0.0.1:8545

# ---------------------------------------------------------------------------
# 2. Next.js public (browser-visible) — apps/web/.env.local
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Never put database URLs, proof keys, tokens or provider secrets in NEXT_PUBLIC_*.

# ---------------------------------------------------------------------------
# 3. Wallet sign-in + research backend — SERVER ONLY (apps/web/.env.local or
#    your host's secret store). Disabled until ALL four required values exist.
# ---------------------------------------------------------------------------
# PRIGENFI_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# PRIGENFI_APP_ORIGIN=https://your-trusted-prigenfi-domain.example   # or http://localhost:3000 locally
# PRIGENFI_AUTH_CHAIN_ID=11155111                                    # 31337 for local Anvil
# PRIGENFI_AUTH_RPC_URL=https://your-reviewed-sepolia-rpc.example
# Required for smart-wallet (ERC-1271) sessions. Generate in a secret manager:
#   openssl rand -hex 32
# Rotating it forces ERC-1271 users to sign in again.
# PRIGENFI_AUTH_PROOF_KEY=<64-hex-characters>
# Apply migrations deliberately after a backup:  pnpm db:agents:migrate

# ---------------------------------------------------------------------------
# 4. Hosted MCP (research-only). OFF by default; enable only on a reviewed
#    HTTPS deployment with monitoring and abuse protection.
# ---------------------------------------------------------------------------
# PRIGENFI_MCP_HTTP_ENABLED=true      # wallet-owned, revocable bearer keys
# PRIGENFI_PUBLIC_MCP_ENABLED=true    # anonymous, global 60/min quota

# ---------------------------------------------------------------------------
# 5. Read-only Sepolia verification CLIs (operator shell only)
# ---------------------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Two DIFFERENT operators for pnpm verify:swap:quorum (defaults are public observers):
# PRIGENFI_VENUE_PRIMARY_RPC=https://...
# PRIGENFI_VENUE_SECONDARY_RPC=https://...
# For pnpm assess:account --chain 11155111:
# PRIGENFI_ASSESS_SEPOLIA_RPC=https://...
