# CLI services: export these in your shell. No automatic root dotenv loading.
# No signing secrets belong in this file or repository.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
API_PORT=3001
# Optional MCP fixed scope; use real local deployment public addresses.
# VAULT_ADDRESS=
# AGENT_ADDRESS=
# TOKEN_ADDRESS=

# Next.js: place public configuration in apps/web/.env.local when overriding.
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Read-only registry verification command:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Agent research account service — server-only, disabled until ALL are configured.
# Obtain a dedicated, secured Postgres database; never commit its URI or password.
# PRIGENFI_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# PRIGENFI_APP_ORIGIN=https://your-trusted-prigenfi-domain.example
# PRIGENFI_AUTH_CHAIN_ID=11155111
# PRIGENFI_AUTH_RPC_URL=https://your-reviewed-sepolia-rpc.example
# PRIGENFI_AUTH_PROOF_KEY=<64-hex-characters-from-a-secure-secret-manager>
# Required for durable ERC-1271 sessions; generate independently per environment.
# Rotating this encryption key forces ERC-1271 users to reauthenticate.
# Run `pnpm db:agents:migrate` intentionally after providing these variables.
# Do not expose these secrets via NEXT_PUBLIC_* variables.

# Experimental, short-lived research-only remote MCP service tokens (not OAuth yet).
# OFF by default; enable only on a trusted, authenticated HTTPS deployment.
# PRIGENFI_MCP_HTTP_ENABLED=true
